From: user <user@host>
Date: Sun, 6 Sep 2026 07:09:07 +0000
Subject: [PATCH] kbuild-use-modern-lz4-flags.patch

---
 scripts/Makefile.lib | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/scripts/Makefile.lib b/scripts/Makefile.lib
index 4377f6eb1089..50d41e8bbe2e 100644
--- a/scripts/Makefile.lib
+++ b/scripts/Makefile.lib
@@ -380,7 +380,7 @@ cmd_lzo = (cat $(filter-out FORCE,$^) | \
 
 quiet_cmd_lz4 = LZ4     $@
 cmd_lz4 = (cat $(filter-out FORCE,$^) | \
-	lz4c -9) > $@ || \
+	lz4 -c -l -9) > $@ || \
 	(rm -f $@ ; false)
 
 # U-Boot mkimage
